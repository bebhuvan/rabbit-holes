      }

      <span class="dt-tall-scrub" data-scrub-line-tall style={`top:${pT(T0)}%`} />

    </div>

    <p class="dt-tall-metal">2% — everything heavier than helium, all of it after the first stars</p>

    <dl class="dt-tall-list">
      <dt class="dt-tall-list-head">And then, for thirteen billion years</dt>
      {
        detailEvents.map((moment) => (
          <div class="dt-tall-row">
            <dt>{moment.tick}</dt>
            <dd>{moment.display}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  {/* The table equivalent. Absent until now, which every other figure in this
