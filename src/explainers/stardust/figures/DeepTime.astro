<script>
  import { onProgress } from '../../kit/scrolly.js';
  import { scrubAt, scrubX, compositionAt, when, readout } from './deeptime.js';

  type Bind = {
    pl: number;
    pr: number;
    l0: number;
    lspan: number;
    bandTop: number;
    bandBottom: number;
    targets: number[];
    /** [log10 t, quarks, protons, neutrons, helium, metals] */
    abundance: number[][];
  };

  const setup = () => {
    for (const figure of document.querySelectorAll<HTMLElement>('[data-deeptime]')) {
      const scrolly = figure.closest<HTMLElement>('[data-ex-scrolly]');
      const raw = figure.dataset.bind;
      if (!scrolly || !raw) continue;

      const bind: Bind = JSON.parse(raw);
      const line = figure.querySelector<SVGLineElement>('.dt-wide .scrub-line');
      // The portrait layout's words are HTML now, so its scrub is a percentage
      // down a grid cell rather than a y in user units.
      const tallLine = figure.querySelector<HTMLElement>('[data-scrub-line-tall]');
      const tallWhen = figure.querySelector<HTMLElement>('[data-scrub-when-tall]');
      const whenTexts = Array.from(
        figure.querySelectorAll<SVGTextElement | HTMLElement>(
          '[data-scrub-when], [data-scrub-when-tall]'
        )
      );
      const whenText = whenTexts[0];
      const whatText = figure.querySelector<SVGTextElement>('[data-scrub-what]');
      const events = Array.from(figure.querySelectorAll<SVGGElement>('[data-event]'));
      if (!line || !whenText || !whatText) continue;

      const logTargets = bind.targets.map((t) => Math.log10(t));

      /**
       * A pure function of scroll position, and deliberately nothing more —
       * every calculation it does lives in deeptime.js and is unit-tested for
       * reversibility. Feed it 0.4 then 0.2 and it lands exactly where 0.2
       * landed the first time.
       */
      const draw = (_overall: number, step: number, within: number) => {
        const logT = scrubAt(step, within, logTargets);
        const px = scrubX(logT, bind);

        line.setAttribute('x1', String(px));
        line.setAttribute('x2', String(px));

        // The readout hangs off the line, and flips side rather than running
        // off the plot.
        const flip = px > bind.pr - 300;
        const anchor = flip ? 'end' : 'start';
        const textX = flip ? px - 8 : px + 8;
        for (const node of [whenText, whatText]) {
          node.setAttribute('x', String(textX));
          node.setAttribute('text-anchor', anchor);
        }

        // Both drawings, one scroll position. The hidden one costs two attribute
        // writes a frame and means the reader never sees a stale figure if the
        // viewport changes under them.
        if (tallLine) {
          const pctDown = ((logT - bind.l0) / bind.lspan) * 100;
          tallLine.style.top = `${pctDown}%`;
          if (tallWhen) tallWhen.style.top = `${pctDown}%`;
        }
        for (const node of whenTexts) node.textContent = when(logT);
        whatText.textContent = readout(compositionAt(logT, bind.abundance));

        // Mark the moment the line has reached or passed most recently.
        let reached = -1;
        for (let i = 0; i < events.length; i++) {
          const at = Number(events[i].dataset.at);
          if (Number.isFinite(at) && at <= logT + 1e-9) reached = i;
        }
        for (let i = 0; i < events.length; i++) {
          events[i].setAttribute('data-active', i === reached ? 'true' : 'false');
        }
      };

      onProgress(scrolly, draw);
      draw(0, 0, 0);
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup, { once: true });
  } else {
    setup();
  }
  document.addEventListener('astro:page-load', setup);
</script>
