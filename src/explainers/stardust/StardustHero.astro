---
/**
 * The thesis, expressed as one transformation.
 *
 * The same body is measured twice. One hundred equal marks represent atom
 * count; the area strip represents mass. The visual flips from 61% primordial
 * to roughly 90% stellar without resorting to a body silhouette or a space
 * illustration. It is data, but composed as an opening image.
 */
const atoms = Array.from({ length: 100 }, (_, i) => ({
  x: i % 10,
  y: Math.floor(i / 10),
  primordial: i < 61,
}));
---

<section
  class="stardust-hero"
  role="img"
  aria-label="The same human body measured in two ways. By atom count, 61 of every 100 atoms are primordial hydrogen made before stars. By mass, only about 9.5 per cent is primordial hydrogen and roughly nine tenths is material assembled after stars formed."
>
  <header class="hero-head">
    <p>One body · two measures</p>
    <span>01 / visual thesis</span>
  </header>

  <div class="hero-grid">
    <div class="hero-count">
      <div class="hero-label">
        <span>By atom count</span>
        <strong>61<sup>%</sup></strong>
        <p>primordial</p>
      </div>

      <svg class="atom-field" viewBox="0 0 318 318" aria-hidden="true">
        {
          atoms.map((atom) => (
            <circle
              cx={15 + atom.x * 32}
              cy={15 + atom.y * 32}
              r={atom.primordial ? 5.2 : 3.25}
              class:list={{ primordial: atom.primordial, stellar: !atom.primordial }}
            />
          ))
        }
        <path class="count-bracket" d="M3 3H315V199H3" />
      </svg>
    </div>

    <div class="hero-turn" aria-hidden="true">
      <span class="turn-line"></span>
      <span class="turn-word">the measure changes</span>
      <span class="turn-arrow">→</span>
    </div>

    <div class="hero-mass">
      <div class="hero-label">
        <span>By body mass</span>
        <strong>≈90<sup>%</sup></strong>
        <p>stellar</p>
      </div>

      <div class="mass-field" aria-hidden="true">
        <div class="mass-primordial">
          <span>9.5%</span>
          <small>primordial H</small>
        </div>
        <div class="mass-stellar">
          <span>≈90%</span>
          <small>assembled after stars formed</small>
        </div>
      </div>
    </div>
  </div>

  <footer class="hero-answer">
    <p><span>By count</span> you are older than stars.</p>
    <p><span>By mass</span> you were made by them.</p>
  </footer>
</section>

<style>
  .stardust-hero {
    --blue: #244a9b;
    --vermilion: #d94d35;
    --black: #111216;
    --grey: #74767d;
    grid-column: full;
    width: min(100%, 88rem);
    margin: clamp(3rem, 8vw, 7rem) auto 0;
    color: var(--black);
    background: #fff;
    border-top: 1px solid var(--black);
    border-bottom: 1px solid var(--black);
  }
  .hero-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 0.8rem 0;
    border-bottom: 1px solid #d9dbe0;
    font-family: var(--mono);
    font-size: 0.6rem;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--grey);
  }
  .hero-head p {
    margin: 0;
    color: var(--black);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 7rem minmax(0, 1fr);
    min-height: clamp(30rem, 45vw, 42rem);
    align-items: stretch;
  }
  .hero-count,
  .hero-mass {
    display: grid;
    grid-template-columns: minmax(9rem, 0.58fr) minmax(15rem, 1fr);
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
  }
  .hero-count {
    padding-right: clamp(1rem, 3vw, 3rem);
  }
  .hero-mass {
    padding-left: clamp(1rem, 3vw, 3rem);
  }
  .hero-label > span {
    display: block;
    font-family: var(--mono);
    font-size: clamp(0.55rem, 0.75vw, 0.68rem);
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--grey);
  }
  .hero-label strong {
    display: block;
    margin-top: 0.7rem;
    font-family: var(--display);
    font-size: clamp(4.7rem, 10vw, 9.5rem);
    font-weight: 400;
    line-height: 0.75;
    letter-spacing: -0.07em;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .hero-count .hero-label strong,
  .hero-count .hero-label p {
    color: var(--blue);
  }
  .hero-mass .hero-label strong,
  .hero-mass .hero-label p {
    color: var(--vermilion);
  }
  .hero-label sup {
    font-size: 0.34em;
    vertical-align: top;
    position: relative;
    top: 0.12em;
    margin-left: 0.08em;
    letter-spacing: 0;
  }
  .hero-label p {
    margin: 1rem 0 0;
    font-family: var(--display);
    font-size: clamp(1.2rem, 2vw, 1.8rem);
    font-style: italic;
    line-height: 1;
  }
  .atom-field {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .atom-field circle {
    vector-effect: non-scaling-stroke;
  }
  .atom-field .primordial {
    fill: var(--blue);
  }
  .atom-field .stellar {
    fill: var(--vermilion);
    opacity: 0.82;
  }
  .count-bracket {
    fill: none;
    stroke: var(--blue);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .hero-turn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    color: var(--grey);
  }
  .turn-line {
    height: 9rem;
    width: 1px;
    background: #c5c7cc;
  }
  .turn-word {
    writing-mode: vertical-rl;
    font-family: var(--mono);
    font-size: 0.55rem;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .turn-arrow {
    color: var(--black);
    font-size: 1.6rem;
    font-weight: 300;
  }
  .mass-field {
    height: clamp(17rem, 25vw, 25rem);
    display: grid;
    grid-template-columns: 9.5fr 90.5fr;
    border: 1px solid var(--black);
  }
  .mass-field > div {
    position: relative;
    min-width: 0;
  }
  .mass-primordial {
    background: var(--blue);
    color: #fff;
  }
  .mass-stellar {
    background: var(--vermilion);
    color: #fff;
    border-left: 1px solid #fff;
  }
  .mass-field span,
  .mass-field small {
    position: absolute;
    font-family: var(--mono);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .mass-field span {
    left: 0.75rem;
    top: 0.8rem;
    font-size: 0.7rem;
  }
  .mass-field small {
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.8rem;
    font-size: 0.52rem;
    line-height: 1.35;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }
  .mass-primordial span,
  .mass-primordial small {
    writing-mode: vertical-rl;
    left: 50%;
    transform: translateX(-50%);
  }
  .mass-primordial span {
    top: 0.75rem;
  }
  .mass-primordial small {
    bottom: 0.75rem;
    right: auto;
  }
  .hero-answer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid #d9dbe0;
  }
  .hero-answer p {
    margin: 0;
    padding: 1.2rem 0;
    font-family: var(--display);
    font-size: clamp(1rem, 1.7vw, 1.45rem);
    line-height: 1.2;
  }
  .hero-answer p + p {
    text-align: right;
  }
  .hero-answer span {
    font-family: var(--mono);
    font-size: 0.52em;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--grey);
    margin-right: 0.5rem;
  }
  @media (max-width: 900px) {
    .hero-head {
      padding-inline: 1rem;
    }
    .hero-grid {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .hero-count,
    .hero-mass {
      grid-template-columns: minmax(8rem, 0.6fr) minmax(10rem, 1fr);
      padding: 2.5rem 1rem;
    }
    .hero-turn {
      flex-direction: row;
      justify-content: flex-start;
      padding: 0 1rem;
    }
    .turn-line {
      width: min(10rem, 35vw);
      height: 1px;
    }
    .turn-word {
      writing-mode: horizontal-tb;
    }
    .turn-arrow {
      margin-left: auto;
      transform: rotate(90deg);
    }
    .mass-field {
      height: 16rem;
    }
    .hero-answer {
      grid-template-columns: 1fr;
      padding-inline: 1rem;
    }
    .hero-answer p + p {
      text-align: left;
      border-top: 1px solid #d9dbe0;
    }
  }
  @media (max-width: 520px) {
    .stardust-hero {
      width: 100%;
    }
    .hero-head span {
      display: none;
    }
    .hero-count,
    .hero-mass {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .hero-label {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: end;
    }
    .hero-label > span,
    .hero-label p {
      grid-column: 1;
    }
    .hero-label strong {
      grid-column: 2;
      grid-row: 1 / 3;
      margin: 0;
      font-size: clamp(4.8rem, 25vw, 6.4rem);
    }
    .atom-field {
      max-width: 19rem;
      margin-inline: auto;
    }
    .mass-field {
      height: 13rem;
    }
    .hero-answer span {
      display: block;
      margin-bottom: 0.4rem;
    }
  }
</style>
