---
export const prerender = true;

import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FolioPreview from '../components/FolioPreview.astro';
import IndexRail from '../components/IndexRail.astro';
import {
  buildFolioNumbers,
  newestFirst,
  relatedPosts,
} from '../utils/content';

const allPosts = await getCollection('posts');
const posts = newestFirst(allPosts);
const folioNumbers = buildFolioNumbers(posts);
const recent = posts.slice(0, 7);
const monthOf = (post: (typeof posts)[number]) =>
  post.data.date.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
const older = posts.slice(Math.min(20, posts.length));
const stackIndex = older.length ? Math.floor(Date.now() / 86_400_000) % older.length : 0;
const fromStacks = older[stackIndex];
const lastKept = posts[0]?.data.date;
---

<Base
  title="Rabbit Holes"
  description="A public commonplace book: links, quotes, poems and stray thoughts, gathered as they struck me."
  active="index"
>
  <div class="shell">
    <IndexRail posts={posts} />

    <main class="stream">
      <section class="thesis">
        <span class="orn" aria-hidden="true">❦</span>
        <div class="kicker"><b>¶ {posts.length}</b> · a public commonplace book</div>
        <h1><span>Hi, I’m Bhuvan.</span><span>This is my <em>commonplace book</em>.</span></h1>
        <p class="lede">
          It is a linkblog and digital garden for the weird, wonderful, and unexpectedly useful things
          I find on the internet. Read what I have kept below, wander through a
          <a href="/heads">subject</a>, or visit <a href="https://smallweb.blog" target="_blank" rel="noopener noreferrer">Small Web</a>,
          my directory of independent blogs.
        </p>
        <div class="thesis-links">
          <a href="/collections">A good place to start <span aria-hidden="true">→</span></a>
          <a href="/study-notes">Browse my study notes <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <div class="eyebrow">Recently kept <span class="flr">❦</span></div>

      {recent.map((post, index) => (
        <>
          {/* A quiet station marker as the months turn — the stream is one
              continuous column, so time needs its own punctuation. */}
          {(index === 0 || monthOf(post) !== monthOf(recent[index - 1])) && (
            <div class="month-mark">{monthOf(post)}</div>
          )}
          <FolioPreview
            post={post}
            number={folioNumbers.get(post.slug) || 0}
            total={posts.length}
            relatedCount={relatedPosts(post, posts).length}
            rubric={index === 0}
            latest={index === 0}
          />
        </>
      ))}

      {fromStacks && (
        <section class="stacks">
          <div class="stacks-head">
            <span class="ast">⁂</span>
            <span class="t">Pulled from the stacks</span>
            <a class="again" href="/archive">pull another from the archive →</a>
          </div>
          <p class="stacks-sub">One older leaf, brought back into the light.</p>
          <FolioPreview
            post={fromStacks}
            number={folioNumbers.get(fromStacks.slug) || 0}
            total={posts.length}
            relatedCount={relatedPosts(fromStacks, posts).length}
          />
        </section>
      )}

      <div class="stream-end" aria-label="End of the recent folios">
        <span class="flr">❦</span>
        <span>{posts.length} folios{lastKept && <> · last kept {lastKept.toLocaleDateString('en-GB', { day: 'numeric', month: 'long' })}</>}</span>
        <a href="/archive">Open the full archive →</a>
      </div>
    </main>
  </div>
</Base>
