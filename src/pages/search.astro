---
export const prerender = true;

import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import '../styles/ledger.css';
import { canonicalTags, newestFirst } from '../utils/content';

const posts = newestFirst(await getCollection('posts'));
const tags = canonicalTags(posts).slice(0, 18);
---

<Base title="Search" description="Search the titles, subjects, and text of the commonplace book." active="search">
  <main class="page-shell" style="max-width:52rem">
    <header class="ledger-head">
      <div class="ledger-kicker">Search · {posts.length} folios</div>
      <h1>Find a thread.</h1>
      <p>Search titles, subjects, and a compact index of the text. The full book is loaded only when you begin typing.</p>
    </header>
    <div class="ledger-tools">
      <label class="visually-hidden" for="search-query">Search Rabbit Holes</label>
      <input class="ledger-search" id="search-query" type="search" placeholder="Try “attention”, “China”, or “poetry”…" autocomplete="off" autofocus />
    </div>
    <p class="search-status" data-search-status>Choose a subject below, or begin typing.</p>
    <div class="search-results" data-search-results></div>
    <div class="tag-cloud" data-search-suggestions>
      {tags.map((tag) => <a href={`/tags/${tag.slug}`}>{tag.name} · {tag.count}</a>)}
    </div>
  </main>

  <script>
    interface SearchItem {
      slug: string;
      number: string;
      title: string;
      description: string;
      content: string;
      kind: string;
      kindLabel: string;
      tags: string[];
      date: string;
    }

    const input = document.querySelector<HTMLInputElement>('#search-query');
    const results = document.querySelector<HTMLElement>('[data-search-results]');
    const status = document.querySelector<HTMLElement>('[data-search-status]');
    const suggestions = document.querySelector<HTMLElement>('[data-search-suggestions]');
    let index: SearchItem[] | null = null;

    const loadIndex = async () => {
      if (index) return index;
      status && (status.textContent = 'Opening the index…');
      const response = await fetch('/search-index.json');
      if (!response.ok) throw new Error('Search index unavailable');
      index = await response.json();
      return index!;
    };

    const render = (items: SearchItem[], term: string) => {
      if (!results || !status) return;
      results.replaceChildren();
      status.textContent = items.length
        ? `${items.length} ${items.length === 1 ? 'folio' : 'folios'} for “${term}”.`
        : `No folios found for “${term}”.`;

      items.slice(0, 40).forEach((item) => {
        const link = document.createElement('a');
        link.className = 'search-result';
        link.href = `/posts/${item.slug}`;

        const number = document.createElement('span');
        number.className = 'result-num';
        number.textContent = item.number;

        const body = document.createElement('span');
        const title = document.createElement('h2');
        title.textContent = item.title;
        const description = document.createElement('p');
        description.textContent = item.description;
        const meta = document.createElement('span');
        meta.className = 'result-meta';
        meta.textContent = `${item.kindLabel} · ${item.tags.slice(0, 3).join(' · ')}`;
        body.append(title, description, meta);
        link.append(number, body);
        results.append(link);
      });
    };

    input?.addEventListener('input', async () => {
      const term = input.value.trim().toLowerCase();
      suggestions && (suggestions.hidden = term.length > 0);
      if (term.length < 2) {
        results?.replaceChildren();
        status && (status.textContent = 'Type at least two characters.');
        return;
      }
      try {
        const data = await loadIndex();
        const terms = term.split(/\s+/);
        const matches = data
          .map((item) => {
            const title = item.title.toLowerCase();
            const tags = item.tags.join(' ').toLowerCase();
            const haystack = `${title} ${tags} ${item.description} ${item.content}`.toLowerCase();
            const score = terms.reduce((total, word) => total +
              (title.includes(word) ? 8 : 0) +
              (tags.includes(word) ? 5 : 0) +
              (haystack.includes(word) ? 1 : -20), 0);
            return { item, score };
          })
          .filter(({ score }) => score >= 0)
          .sort((a, b) => b.score - a.score)
          .map(({ item }) => item);
        render(matches, input.value.trim());
      } catch {
        status && (status.textContent = 'The index could not be opened. Try the archive instead.');
      }
    });

    // Deep-link support: /search?q=… pre-fills the box and runs the query.
    const params = new URLSearchParams(location.search);
    const initial = params.get('q');
    if (initial && input) {
      input.value = initial;
      input.dispatchEvent(new Event('input', { bubbles: true }));
    }
  </script>
</Base>
