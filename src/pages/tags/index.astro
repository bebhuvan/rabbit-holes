---
export const prerender = true;

import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import '../../styles/ledger.css';
import { canonicalTags, newestFirst } from '../../utils/content';

const posts = newestFirst(await getCollection('posts'));
const tags = canonicalTags(posts);
---

<Base title="The Long Tail" description="Every normalized tag in the commonplace book." active="heads">
  <main class="page-shell">
    <header class="ledger-head">
      <div class="ledger-kicker">The long tail · {tags.length} tags</div>
      <h1>Everything mentioned.</h1>
      <p>Subjects are curated paths. Tags are the smaller pencil marks: specific, untidy, and useful when you know what you are looking for.</p>
    </header>
    <div class="tag-cloud">
      {tags.map((tag) => <a href={`/tags/${tag.slug}`}>{tag.name} · {tag.count}</a>)}
    </div>
  </main>
</Base>
