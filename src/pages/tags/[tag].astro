---
export const prerender = true;

import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FolioPreview from '../../components/FolioPreview.astro';
import '../../styles/ledger.css';
import {
  buildFolioNumbers,
  canonicalTags,
  newestFirst,
  postsForTag,
  relatedPosts,
} from '../../utils/content';

export async function getStaticPaths() {
  const posts = newestFirst(await getCollection('posts'));
  return canonicalTags(posts).map((tag) => ({
    params: { tag: tag.slug },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const posts = newestFirst(await getCollection('posts'));
const folioNumbers = buildFolioNumbers(posts);
const taggedPosts = postsForTag(posts, tag.slug);
---

<Base title={tag.name} description={`${taggedPosts.length} folios tagged ${tag.name}.`} active="heads">
  <main class="page-shell head-stream" style="max-width:52rem">
    <header class="ledger-head">
      <div class="ledger-kicker">Tag · {taggedPosts.length} folios</div>
      <h1>{tag.name}</h1>
      <p>A pencil mark from the long tail. <a href="/heads">Browse the hand-chosen subjects</a> for broader paths through the book.</p>
    </header>
    {taggedPosts.map((post) => (
      <FolioPreview
        post={post}
        number={folioNumbers.get(post.slug) || 0}
        total={posts.length}
        relatedCount={relatedPosts(post, posts).length}
      />
    ))}
  </main>
</Base>
