---
export const prerender = true;

import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FolioPreview from '../../components/FolioPreview.astro';
import '../../styles/ledger.css';
import { buildFolioNumbers, newestFirst, postKinds, relatedPosts } from '../../utils/content';

export async function getStaticPaths() {
  return Object.keys(postKinds).map((type) => ({ params: { type } }));
}

const type = Astro.params.type as keyof typeof postKinds;
const kind = postKinds[type];
const posts = newestFirst(await getCollection('posts'));
const folioNumbers = buildFolioNumbers(posts);
const kindPosts = posts.filter((post) => post.data.type === type);
---

<Base title={kind.plural} description={`${kindPosts.length} ${kind.plural.toLowerCase()} in the commonplace book.`} active="index">
  <main class="page-shell head-stream" style="max-width:52rem">
    <header class="ledger-head">
      <div class="ledger-kicker">Kind · {kindPosts.length} folios</div>
      <h1>{kind.plural}</h1>
      <p>A shelf organized by form. For recurring ideas, browse the <a href="/heads">subjects</a>.</p>
    </header>
    {kindPosts.map((post) => (
      <FolioPreview
        post={post}
        number={folioNumbers.get(post.slug) || 0}
        total={posts.length}
        relatedCount={relatedPosts(post, posts).length}
      />
    ))}
  </main>
</Base>
