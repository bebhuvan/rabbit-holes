---
export const prerender = true;

import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import '../../styles/ledger.css';
import { newestFirst, postKinds } from '../../utils/content';

const posts = newestFirst(await getCollection('posts'));
---

<Base title="Five Kinds" description="The five forms a folio can take." active="index">
  <main class="page-shell">
    <header class="ledger-head">
      <div class="ledger-kicker">Five kinds · one book</div>
      <h1>Different shapes of attention.</h1>
      <p>A kind describes the form of a folio. A head describes what it is about.</p>
    </header>
    <div class="head-grid">
      {Object.entries(postKinds).map(([key, kind]) => (
        <a class="head-card" href={`/types/${key}`}>
          <span class="head-count" style={`color:${kind.color}`}>{posts.filter((post) => post.data.type === key).length}</span>
          <h2>{kind.plural}</h2>
          <p>{key === 'links' ? 'Interesting destinations with enough context to know why they matter.' :
            key === 'verse' ? 'Poems and lines that asked to be kept whole.' :
            key === 'reflections' ? 'Longer attempts to think something through.' :
            key === 'practical' ? 'Useful tools, methods, and things worth trying.' :
            'Observations, quotations, and thoughts in the margin.'}</p>
        </a>
      ))}
    </div>
  </main>
</Base>
