---
export const prerender = true;

import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import '../../styles/folio.css';
import {
  buildFolioNumbers,
  chronological,
  displayTag,
  folioLabel,
  formatPostDate,
  postKinds,
  readingTime,
  relatedPosts,
  tagSlug,
} from '../../utils/content';
import { sourceHost, sourceName } from '../../utils/sources';

export async function getStaticPaths() {
  const posts = chronological(await getCollection('posts'));
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const posts = chronological(await getCollection('posts'));
const folioNumbers = buildFolioNumbers(posts);
const number = folioNumbers.get(post.slug) || 0;
const numberLabel = folioLabel(number, posts.length);
const kind = postKinds[post.data.type];
const minutes = readingTime(post.body || '');
const connections = relatedPosts(post, posts, 6);
const index = posts.findIndex((candidate) => candidate.slug === post.slug);
const previous = index > 0 ? posts[index - 1] : undefined;
const next = index < posts.length - 1 ? posts[index + 1] : undefined;
const sourceDomain = post.data.url ? sourceHost(post.data.url) : undefined;
const sourceLabel = post.data.url ? sourceName(post.data.url) : undefined;
/* The rubricated drop cap is reserved for long-form entries (see tokens.css):
   a verse opens on its own measure, and a two-paragraph folio in a drop cap
   is costume, not typography. Only applied when the leaf actually opens on
   a paragraph — the selector's :first-child keeps an opening image or link
   preview from leaving a stray capital mid-page. */
const rubricated = minutes >= 5 && post.data.type !== 'verse';
const { Content } = await post.render();

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description || undefined,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  author: { '@type': 'Person', name: 'Bhuvanesh' },
  mainEntityOfPage: `https://www.rabbitholes.garden/posts/${post.slug}`,
  keywords: (post.data.tags || []).map(displayTag).join(', '),
};
---

<Base
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  active="index"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>

  <article class="folio">
    <aside class="folio-rail" aria-label="Folio details">
      <a class="back" href="/">← home</a>
      <span class="folio-num" style={`color:${kind.color}`}>{numberLabel}</span>
      <span class="folio-word">folio</span>
      <dl>
        <dt>Kept</dt>
        <dd>{formatPostDate(post.data.date, true)}</dd>
        <dt>Kind</dt>
        <dd>{kind.singular}</dd>
        <dt>Length</dt>
        <dd>{minutes} min read</dd>
      </dl>
    </aside>

    <main class="leaf">
      <div class="attrib">{kind.singular} · kept {formatPostDate(post.data.date, true)}</div>
      <h1>{post.data.title}</h1>
      {post.data.author && <p class="byline">by {post.data.author}</p>}

      {post.data.note && (
        <section class:list={['hand', { long: post.data.note.length > 90 }]} aria-label="The collector's note">
          <span class="label">The hand</span>
          <p class="say">{post.data.note}</p>
        </section>
      )}

    {post.data.url && (
      <a
        class="source-card"
        href={post.data.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Read the original at ${sourceLabel} — ${sourceDomain}`}
      >
        <span class="source-card-label">Source</span>
        <span class="source-card-domain">{sourceLabel}</span>
        <span class="source-card-arrow" aria-hidden="true">↗</span>
      </a>
    )}

      <div class:list={['prose', { verse: post.data.type === 'verse', 'rubric-folio': rubricated }]}>
        <Content />
      </div>

      <div class="leaf-mark">❦</div>

      {post.data.dive_deeper?.length > 0 && (
        <section class="deeper">
          <div class="h">Dive deeper</div>
          <ul>
            {post.data.dive_deeper.map((item, itemIndex) => {
              const value = typeof item === 'string' ? { text: item, url: item } : item;
              return (
                <li>
                  <span class="n">{String(itemIndex + 1).padStart(2, '0')}</span>
                  <span>
                    <a href={value.url} target="_blank" rel="noopener noreferrer">{value.text}</a>
                    {'description' in value && value.description && <span class="dsc">{value.description}</span>}
                  </span>
                </li>
              );
            })}
          </ul>
        </section>
      )}

      <div class="post-actions">
        <button type="button" data-copy-link>copy this folio</button>
        <a href="/rss.xml">follow by RSS</a>
      </div>
    </main>

    <aside class="margin" aria-label="Margin notes">
      {/* The notes travel with the reader; the rule stays with the leaf. Two
          or three sidenotes at the top of a 3000px column left the whole
          right-hand side of the page empty below the first screen. */}
      <div class="margin-notes">
      {(post.data.tags || []).length > 0 && (
        <div class="sidenote">
          <span class="sl">Filed under</span>
          <div class="heads">
            {post.data.tags.map((tag) => <a href={`/tags/${tagSlug(tag)}`}>{displayTag(tag)}</a>)}
          </div>
        </div>
      )}
      {post.data.via && (
        <div class="sidenote">
          <span class="sl">Found via</span>
          <div class="sb">{post.data.via}</div>
        </div>
      )}
      {(previous || next) && (
        <div class="sidenote">
          <span class="sl">Neighbours in time</span>
          <div class="sb">
            {previous && <a class="nb" href={`/posts/${previous.slug}`}>←&nbsp;{previous.data.title}</a>}
            {next && <a class="nb" href={`/posts/${next.slug}`}>{next.data.title}&nbsp;→</a>}
          </div>
        </div>
      )}
      </div>
    </aside>

    {connections.length > 0 && (
      <section class="threads" id="threads">
        <div class="h"><span class="mani">☞</span> Threads from here</div>
        <p class="hsub">Nearby leaves, connected by subject and form.</p>
        <div class="thread-grid">
          {connections.map(({ post: connection, reason }) => {
            const connectionNumber = folioNumbers.get(connection.slug) || 0;
            return (
              <a class="thread" href={`/posts/${connection.slug}`}>
                <span class="tn" style={`color:${postKinds[connection.data.type].color}`}>
                  {folioLabel(connectionNumber, posts.length)}
                </span>
                <span>
                  <span class="tt">{connection.data.title}</span>
                  <span class="tr">{reason}</span>
                </span>
              </a>
            );
          })}
        </div>
        <a class="all" href="/heads">browse all subjects →</a>
      </section>
    )}
  </article>

  <script>
    document.querySelector<HTMLButtonElement>('[data-copy-link]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      try {
        await navigator.clipboard.writeText(window.location.href);
        button.textContent = 'copied';
        window.setTimeout(() => { button.textContent = 'copy this folio'; }, 1800);
      } catch {
        button.textContent = 'copy failed';
      }
    });
  </script>
</Base>
