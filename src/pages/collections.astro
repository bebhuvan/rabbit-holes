---
export const prerender = true;

import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FolioPreview from '../components/FolioPreview.astro';
import '../styles/ledger.css';
import { buildFolioNumbers, newestFirst, relatedPosts } from '../utils/content';

const posts = newestFirst(await getCollection('posts'));
const folioNumbers = buildFolioNumbers(posts);
const featured = posts.filter((post) => post.data.featured).slice(0, 5);
const wayIn = featured.length >= 5 ? featured : posts.slice(0, 5);
---

<Base title="Start Here" description="Five hand-picked ways into Rabbit Holes." active="index">
  <main class="page-shell head-stream" style="max-width:52rem">
    <header class="ledger-head">
      <div class="ledger-kicker">A hand-picked way in · five folios</div>
      <h1>Start with these.</h1>
      <p>The whole book is intentionally sprawling. These five leaves are a smaller door: enough to learn its rhythm without beginning at the beginning.</p>
    </header>
    {wayIn.map((post, index) => (
      <FolioPreview
        post={post}
        number={folioNumbers.get(post.slug) || 0}
        total={posts.length}
        relatedCount={relatedPosts(post, posts).length}
        rubric={index === 0}
      />
    ))}
  </main>
</Base>
