---
export const prerender = true;

import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import '../styles/ledger.css';
import {
  buildFolioNumbers,
  displayTag,
  folioLabel,
  newestFirst,
  postKinds,
  readingTime,
} from '../utils/content';

const posts = newestFirst(await getCollection('posts'));
const folioNumbers = buildFolioNumbers(posts);
const grouped = new Map<number, Map<string, typeof posts>>();

for (const post of posts) {
  const year = post.data.date.getFullYear();
  const month = post.data.date.toLocaleDateString('en-GB', { month: 'long' });
  if (!grouped.has(year)) grouped.set(year, new Map());
  const months = grouped.get(year)!;
  if (!months.has(month)) months.set(month, []);
  months.get(month)!.push(post);
}
---

<Base title="The Ledger" description={`Every one of the ${posts.length} published folios, in reverse chronological order.`} active="index">
  <div class="ledger-shell">
    <aside class="filter-rail">
      <div class="filter-title">Filter the ledger</div>
      <p class="filter-intro">Every published folio. Search titles and subjects, or narrow by form.</p>
      <ul class="filter-list">
        <li><button class="active" type="button" data-kind="all"><span>Everything</span><span>{posts.length}</span></button></li>
        {Object.entries(postKinds).map(([key, kind]) => (
          <li>
            <button type="button" data-kind={key}>
              <span>{kind.plural}</span><span>{posts.filter((post) => post.data.type === key).length}</span>
            </button>
          </li>
        ))}
      </ul>
    </aside>

    <main class="ledger-main">
      <header class="ledger-head">
        <div class="ledger-kicker">The ledger · {posts.length} folios</div>
        <h1>Everything kept.</h1>
        <p>The book in full, newest first. Folio numbers run the other way: the oldest leaf is always number one.</p>
      </header>
      <div class="ledger-tools">
        <label class="visually-hidden" for="ledger-query">Search the ledger</label>
        <input class="ledger-search" id="ledger-query" type="search" placeholder="Search titles and subjects…" autocomplete="off" />
      </div>

      <div data-ledger>
        {[...grouped.entries()].map(([year, months]) => (
          <section class="year-block" data-year-block>
            <h2 class="year-title">{year}</h2>
            {[...months.entries()].map(([month, monthPosts]) => (
              <div data-month-block>
                <h3 class="month-title">{month}</h3>
                {monthPosts.map((post) => {
                  const kind = postKinds[post.data.type];
                  const number = folioNumbers.get(post.slug) || 0;
                  const search = `${post.data.title} ${(post.data.tags || []).map(displayTag).join(' ')}`.toLowerCase();
                  return (
                    <a
                      class="ledger-row"
                      href={`/posts/${post.slug}`}
                      data-ledger-row
                      data-kind={post.data.type}
                      data-search={search}
                    >
                      <span class="ledger-num" style={`color:${kind.color}`}>{folioLabel(number, posts.length)}</span>
                      <span class="ledger-date">{post.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' })}</span>
                      <span class="ledger-row-title">{post.data.title}</span>
                      <span class="ledger-read">{readingTime(post.body || '')} min</span>
                    </a>
                  );
                })}
              </div>
            ))}
          </section>
        ))}
      </div>
      <p class="empty-state" data-ledger-empty hidden>Nothing in the ledger matches that combination.</p>
    </main>
  </div>

  <script>
    const query = document.querySelector<HTMLInputElement>('#ledger-query');
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-kind]')];
    const rows = [...document.querySelectorAll<HTMLElement>('[data-ledger-row]')];
    const empty = document.querySelector<HTMLElement>('[data-ledger-empty]');
    let selectedKind = 'all';

    const applyFilters = () => {
      const term = query?.value.trim().toLowerCase() || '';
      let visible = 0;
      rows.forEach((row) => {
        const matchesKind = selectedKind === 'all' || row.dataset.kind === selectedKind;
        const matchesTerm = !term || row.dataset.search?.includes(term);
        row.hidden = !(matchesKind && matchesTerm);
        if (!row.hidden) visible += 1;
      });
      document.querySelectorAll<HTMLElement>('[data-month-block]').forEach((block) => {
        block.hidden = !block.querySelector('[data-ledger-row]:not([hidden])');
      });
      document.querySelectorAll<HTMLElement>('[data-year-block]').forEach((block) => {
        block.hidden = !block.querySelector('[data-ledger-row]:not([hidden])');
      });
      if (empty) empty.hidden = visible > 0;
    };

    query?.addEventListener('input', applyFilters);
    buttons.forEach((button) => button.addEventListener('click', () => {
      selectedKind = button.dataset.kind || 'all';
      buttons.forEach((candidate) => candidate.classList.toggle('active', candidate === button));
      applyFilters();
    }));
  </script>
</Base>
