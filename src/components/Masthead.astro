---
interface Props {
  active?: 'index' | 'heads' | 'explainers' | 'study-notes' | 'search' | 'about';
}

const { active } = Astro.props;
const links = [
  { key: 'index', label: 'Home', href: '/' },
  { key: 'heads', label: 'Subjects', href: '/heads' },
  { key: 'explainers', label: 'Explainers', href: '/explainers' },
  { key: 'study-notes', label: 'Study notes', href: '/study-notes' },
  { key: 'search', label: 'Search', href: '/search' },
  { key: 'about', label: 'About', href: '/about' },
] as const;
---

<header class="masthead">
  <div class="masthead-inner">
    <a class="brand" href="/" aria-label="Rabbit Holes home">
      <span class="mark">Rabbit Holes</span>
      <span class="sub">a commonplace book,<span class="flr">❦</span>kept in the open</span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      Menu
    </button>
    <nav id="site-nav" aria-label="Primary" data-site-nav data-open="false">
      {links.map((link) => (
        <a href={link.href} class={active === link.key ? 'on' : undefined} aria-current={active === link.key ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
      <button class="lamp" type="button" title="Light / lamplight" aria-label="Toggle light and dark theme" data-theme-toggle>☽</button>
    </nav>
  </div>
</header>
