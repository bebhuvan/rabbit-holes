---
import '../styles/tokens.css';
import '../styles/commonplace.css';
import Masthead from '../components/Masthead.astro';
import SiteFooter from '../components/SiteFooter.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  active?: 'index' | 'heads' | 'glosses' | 'search' | 'about';
  noindex?: boolean;
}

const {
  title,
  description = 'A public commonplace book: links, quotes, poems and stray thoughts, kept in the open.',
  image,
  active,
  noindex = false,
} = Astro.props;

const pageTitle = title === 'Rabbit Holes' ? title : `${title} — Rabbit Holes`;
const canonical = new URL(Astro.url.pathname, Astro.site || 'https://www.rabbitholes.garden');
const socialImage = image ? new URL(image, canonical).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Bhuvanesh" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#181713" media="(prefers-color-scheme: dark)" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Rabbit Holes RSS" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..600&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..500&family=Spline+Sans+Mono:wght@400..600&display=swap"
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rabbit Holes" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}

    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('rabbit-holes-theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.dataset.theme = saved;
          }
        } catch {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to the page</a>
    <Masthead active={active} />
    <div id="content">
      <slot />
    </div>
    <SiteFooter />

    <script>
      const root = document.documentElement;
      const lamp = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const navToggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
      const nav = document.querySelector<HTMLElement>('[data-site-nav]');

      lamp?.addEventListener('click', () => {
        const rendered = root.dataset.theme ||
          (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = rendered === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('rabbit-holes-theme', next); } catch {}
        lamp.setAttribute('aria-label', `Use ${rendered} theme`);
      });

      navToggle?.addEventListener('click', () => {
        const open = nav?.dataset.open === 'true';
        if (nav) nav.dataset.open = String(!open);
        navToggle.setAttribute('aria-expanded', String(!open));
      });

      nav?.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a')) {
          nav.dataset.open = 'false';
          navToggle?.setAttribute('aria-expanded', 'false');
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && nav?.dataset.open === 'true') {
          nav.dataset.open = 'false';
          navToggle?.setAttribute('aria-expanded', 'false');
          navToggle?.focus();
        }
      });

      const previews = Array.from(document.querySelectorAll<HTMLElement>('[data-link-preview]'));
      const previewRequests = new Map<string, Promise<{
        title?: string;
        description?: string;
        image?: string | null;
      }>>();

      const loadPreview = async (card: HTMLElement) => {
        const url = card.dataset.previewUrl;
        if (!url || card.dataset.previewState) return;
        card.dataset.previewState = 'loading';

        try {
          let request = previewRequests.get(url);
          if (!request) {
            request = fetch(`/api/metadata?${new URLSearchParams({ url })}`)
              .then((response) => {
                if (!response.ok) throw new Error('Preview unavailable');
                return response.json();
              });
            previewRequests.set(url, request);
          }

          const metadata = await request;
          const title = card.querySelector<HTMLElement>('[data-preview-title]');
          const description = card.querySelector<HTMLElement>('[data-preview-description]');
          const imageWrap = card.querySelector<HTMLElement>('[data-preview-image]');
          const image = imageWrap?.querySelector<HTMLImageElement>('img');

          if (title && metadata.title) title.textContent = metadata.title;
          if (description && metadata.description) {
            description.textContent = metadata.description;
            description.hidden = false;
          }
          if (imageWrap && image && metadata.image) {
            image.addEventListener('error', () => { imageWrap.hidden = true; }, { once: true });
            image.src = metadata.image;
            imageWrap.hidden = false;
          }
          card.dataset.previewState = 'ready';
        } catch {
          card.dataset.previewState = 'fallback';
        }
      };

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            observer.unobserve(entry.target);
            void loadPreview(entry.target as HTMLElement);
          }
        }, { rootMargin: '600px 0px' });
        previews.forEach((preview) => observer.observe(preview));
      } else {
        previews.forEach((preview) => { void loadPreview(preview); });
      }

      const tweetEmbeds = document.querySelectorAll<HTMLElement>('[data-tweet-embed]');
      if (tweetEmbeds.length) {
        const theme = root.dataset.theme ||
          (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        tweetEmbeds.forEach((embed) => {
          const tweet = embed.querySelector<HTMLElement>('.twitter-tweet');
          if (tweet) tweet.dataset.theme = theme;
        });

        if (!document.querySelector('#twitter-widgets')) {
          const script = document.createElement('script');
          script.id = 'twitter-widgets';
          script.src = 'https://platform.twitter.com/widgets.js';
          script.async = true;
          document.head.append(script);
        }
      }
    </script>
  </body>
</html>
